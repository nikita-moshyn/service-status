{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://status.example/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "publicUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "name",
        "publicUrl"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,39}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
        },
        "branch": {
          "const": "main"
        }
      },
      "required": [
        "owner",
        "name",
        "branch"
      ],
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
      },
      "maxItems": 30,
      "minItems": 1,
      "uniqueItems": true
    },
    "freshnessSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 3600
    },
    "failureThreshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "recoveryThreshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "name",
          "url"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
            },
            "maxItems": 100,
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "projectIds"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "groupId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
            },
            "maxItems": 100,
            "uniqueItems": true,
            "minItems": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "expectedStatus": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          },
          "expectedBody": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 500,
            "maximum": 10000
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "groupId",
          "componentIds",
          "url",
          "expectedStatus",
          "expectedBody",
          "timeoutMs",
          "enabled"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "brand",
    "repository",
    "languages",
    "freshnessSeconds",
    "failureThreshold",
    "recoveryThreshold",
    "projects",
    "components",
    "monitors"
  ],
  "additionalProperties": false
}
