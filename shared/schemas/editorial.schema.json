{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://status.example/schemas/editorial.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "kind": {
            "enum": [
              "incident",
              "maintenance"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
            },
            "maxItems": 100,
            "uniqueItems": true,
            "minItems": 1
          },
          "phase": {
            "enum": [
              "investigating",
              "identified",
              "monitoring",
              "resolved",
              "scheduled",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "endsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "phase": {
                  "enum": [
                    "investigating",
                    "identified",
                    "monitoring",
                    "resolved",
                    "scheduled",
                    "in_progress",
                    "completed",
                    "cancelled"
                  ]
                },
                "translations": {
                  "type": "object",
                  "maxProperties": 30,
                  "propertyNames": {
                    "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                }
              },
              "required": [
                "id",
                "at",
                "phase",
                "translations"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "componentIds",
          "phase",
          "createdAt",
          "startsAt",
          "endsAt",
          "updates"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    }
  },
  "required": [
    "schemaVersion",
    "incidents"
  ],
  "additionalProperties": false
}
